# ==============================================================================
# WELELE MEDIA CORPORATE WEBSITE - ENVIRONMENT CONFIGURATION (STANDALONE)
# ==============================================================================
# IMPORTANT ARCHITECTURAL RULE:
# This system has ZERO runtime coupling to welele.app.
# DO NOT insert credentials, database URLs, or buckets belonging to the Welele app.
# All production secrets must be generated independently for this project.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONTENT SOURCE & DATABASE CONFIGURATION (Dedicated PostgreSQL)
# ------------------------------------------------------------------------------
# Operational content mode:
# - 'static' (default launch state): Directly serves typed defaults without database attempts or latency.
# - 'database' / 'auto': Uses PostgreSQL via Prisma when provisioned.
CONTENT_SOURCE="static"

# Dedicated PostgreSQL instance strictly owned by Welele Media Corporate Website.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# Leave empty during Standby / Inspection Mode.
DATABASE_URL=""

# ------------------------------------------------------------------------------
# 2. STANDALONE CMS ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
# Administrator credentials for CMS Control Room access
ADMIN_USERNAME="admin"
# Bcrypt hash of admin password. Generate using: node -e "require('bcryptjs').hash('YourPassword', 10).then(console.log)"
ADMIN_PASSWORD_HASH=""

# Cryptographically secure random secret (min 32 chars) for signing admin session tokens.
# Generate via: openssl rand -base64 32
ADMIN_JWT_SECRET="GENERATE_RANDOM_SECRET_MIN_32_CHARS"
ADMIN_SESSION_COOKIE="welele_media_admin_session"
ADMIN_SESSION_MAX_AGE_SECONDS=86400

# ------------------------------------------------------------------------------
# 3. DEDICATED MEDIA STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Options: 'local' (development default) or 's3' (production Cloudflare R2 / AWS S3)
STORAGE_PROVIDER="local"

# Production S3/R2 Configuration (Only needed when STORAGE_PROVIDER="s3")
# MUST be a dedicated corporate bucket (e.g., welele-media-production)
# NEVER configure or reference welele-vod-staging or welele-vod-production!
MEDIA_S3_BUCKET="welele-media-production"
MEDIA_S3_REGION="auto"
MEDIA_S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
MEDIA_S3_ACCESS_KEY_ID="DEDICATED_ACCESS_KEY_ID"
MEDIA_S3_SECRET_ACCESS_KEY="DEDICATED_SECRET_ACCESS_KEY"
MEDIA_S3_PUBLIC_DOMAIN="https://media.welelemedia.co.za"

# ------------------------------------------------------------------------------
# 4. PUBLIC SITE SETTINGS & OUTBOUND LINKS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.welelemedia.co.za"

# Configurable Outbound Watch CTA (Treated strictly as a normal external hyperlink)
# The corporate website remains 100% functional even if this URL is offline or unset.
NEXT_PUBLIC_DEFAULT_WATCH_URL="#stories"
